# ---------- Geral ----------
PORT=3000
PUBLIC_URL=https://atendimento.seuprovedor.com.br
JWT_SECRET=troque-por-um-segredo-longo
DB_PATH=./data/callcenter.db
# Token exigido nos webhooks: configure as URLs como .../webhooks/waha?token=ESTE_VALOR
WEBHOOK_TOKEN=
# Distribui automaticamente para atendentes "Disponível" com menor carga
AUTO_ASSIGN=true

# ---------- SLA (segundos) — padrão global; cada fila pode ter os seus ----------
SLA_TME_ALERT_SEC=120
SLA_TMA_ALERT_SEC=900
SLA_WARN_RATIO=0.8
SLA_CHECK_INTERVAL_SEC=10

# ---------- IA (registro automático do atendimento) ----------
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high — "low" é suficiente para resumos e reduz custo/latência
AI_EFFORT=low

# ---------- WAHA (número separado para grupos de WhatsApp) ----------
WAHA_ENABLED=false
WAHA_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default
# true = só mensagens de grupos entram por este número
WAHA_GROUPS_ONLY=true

# ---------- OPA Suite ----------
# Ajuste os caminhos conforme o JSON real do webhook do OPA (notação a.b.c)
OPA_ENABLED=false
OPA_URL=
OPA_TOKEN=
OPA_SEND_PATH=/api/v1/mensagem
OPA_SEND_BODY={"id_atendimento":"{{chatId}}","mensagem":"{{text}}"}
OPA_FIELDS={"chatId":"atendimento.id","messageId":"mensagem.id","text":"mensagem.texto","contactName":"contato.nome","contactPhone":"contato.telefone","fromMe":"mensagem.enviada","mediaUrl":"mensagem.url_arquivo","timestamp":"mensagem.data"}

# ---------- Chatmix ----------
CHATMIX_ENABLED=false
CHATMIX_URL=
CHATMIX_TOKEN=
CHATMIX_SEND_PATH=/api/messages
CHATMIX_SEND_BODY={"chat_id":"{{chatId}}","text":"{{text}}"}
CHATMIX_FIELDS={"chatId":"chat.id","messageId":"message.id","text":"message.text","contactName":"contact.name","contactPhone":"contact.phone","fromMe":"message.from_me","mediaUrl":"message.media_url","timestamp":"message.timestamp"}

# ---------- IXC Soft ----------
IXC_ENABLED=false
IXC_URL=https://ixc.seuprovedor.com.br
# formato id_usuario:token
IXC_TOKEN=

# ---------- SGP ----------
SGP_ENABLED=false
SGP_URL=https://sgp.seuprovedor.com.br
SGP_TOKEN=
SGP_APP=
